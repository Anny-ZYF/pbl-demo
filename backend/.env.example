# Copy these values into your shell or IDE run configuration. Do not commit real secrets.
DB_URL=jdbc:mysql://127.0.0.1:3306/groupwork?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
# Generate with: openssl rand -base64 32
JWT_SECRET_BASE64=
# Compose frontend defaults to http://localhost; Vite dev defaults to :5173.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
MODEL_SERVICE_URL=http://127.0.0.1:8000
MODEL_SERVICE_TOKEN=replace-with-an-internal-random-token
STORAGE_ROOT=./data/uploads
# Only needed on the first start of an empty database. Remove after bootstrap.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
