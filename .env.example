# Docker Compose reads .env in the repository root. Keep real secrets out of Git.
# Generate separate passwords/tokens with: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
# Generate with: openssl rand -base64 32
JWT_SECRET_BASE64=
MODEL_SERVICE_TOKEN=

# Set this to the exact public origin, including scheme and non-default port.
CORS_ALLOWED_ORIGINS=http://localhost
FRONTEND_PORT=80
# Database/backend ports are bound to 127.0.0.1 by compose.yaml.
MYSQL_PORT=3306
BACKEND_PORT=8080

# First empty-database startup only; remove the password after changing it.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
