ARG JAVA_IMAGE=public.ecr.aws/docker/library/eclipse-temurin:21-jre-jammy
ARG PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.11-slim
ARG NGINX_IMAGE=nginx:1.27-alpine

FROM ${JAVA_IMAGE} AS backend
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 groupwork \
    && mkdir -p /app/data/uploads && chown -R groupwork:groupwork /app
COPY --chown=groupwork:groupwork backend/target/groupwork-1.0.0.jar /app/app.jar
USER groupwork
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=60", "-XX:ActiveProcessorCount=2", "-jar", "/app/app.jar"]

FROM ${PYTHON_IMAGE} AS algorithm
ARG DEBIAN_MIRROR=https://deb.debian.org
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 ALGORITHM_MODEL_DIR=/app/artifacts
WORKDIR /app
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=30 update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && adduser --system --uid 10001 --group algorithm
COPY backend/algorithm-service/requirements.txt ./requirements.txt
COPY deploy/requirements-cpu.txt ./requirements-cpu.txt
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN python -m pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" -r requirements-cpu.txt
COPY --chown=algorithm:algorithm backend/algorithm-service/app ./app
COPY --chown=algorithm:algorithm backend/algorithm-service/artifacts ./artifacts
USER algorithm
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]

FROM ${NGINX_IMAGE} AS frontend
COPY deploy/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY frontend/dist /usr/share/nginx/html
EXPOSE 80
